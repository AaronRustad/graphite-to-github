{
  "manifest_version": 3,
  "name": "Graphite to GitHub",
  "version": "1.0.0",
  "description": "Automatically open Graphite pull request links on GitHub in the same tab.",
  "icons": {
    "48": "icons/redirect.svg",
    "96": "icons/redirect.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "graphite-to-github@aaronrustad.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://app.graphite.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "graphite_pr_redirects",
        "enabled": true,
        "path": "rules/redirects.json"
      }
    ]
  }
}
